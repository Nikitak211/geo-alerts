# Copy this file to .env in the server folder.
# Used by the Node.js backend (server/src/server.js). The .NET backend uses appsettings.json
# and can be overridden by these same env var names when set in the environment (e.g. by Docker or shell).
# Do not commit .env (it is gitignored).

# ---------- Server ports (Node.js) ----------
# WebSocket server port. Default 5535.
PORT=5535
# HTTP API port. Default 8090.
HTTP_PORT=8090

# ---------- CORS and client URL ----------
# Allowed origin for API/WS (React dev server). Default http://localhost:4421.
CORS_ORIGIN=http://localhost:4421
# Public base URL of the client (e.g. for screenshot links). Default http://localhost:4421.
CLIENT_BASE_URL=http://localhost:4421

# ---------- Database ----------
# PostgreSQL connection string. Node uses this; .NET uses ConnectionStrings__DefaultDatabase (or DATABASE_URL in Docker).
DATABASE_URL=Host=localhost;Port=5432;Database=bets;Username=app;Password=app

# ---------- OREF ----------
# Use mock OREF data instead of live feed (true/false).
USE_OREF_MOCK=true
# Optional: .NET OREF poll interval in seconds.
# OREF_POLL_INTERVAL_SECONDS=10
# Optional: OREF feed URL override.
# OREF_URL=

# ---------- Telegram ----------
# Get token from @BotFather; create a channel and add the bot as admin.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Optional: for Telegram Client API. Get from https://my.telegram.org
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# ---------- Optional (.NET / Docker) ----------
# Accept client screenshot uploads and forward to Telegram (true/false).
# ACCEPT_CLIENT_SCREENSHOTS=true
