# Copy to .env in the repo root. Used ONLY by Docker Compose (docker compose up).
# Not used by the client or server when run locally. Do not commit .env (gitignored).
# Placeholder values only. Set real secrets in .env locally or on the Pi portal Env page.

# ---------- Database ----------
# Required. Compose always starts Postgres (service `db`, database `geoalerts`, user `app`).
# The Pi portal must set this. Locally any placeholder is fine if you use DATABASE_URL below.
POSTGRES_PASSWORD=change-me

# Leave unset to use the bundled db (hostname `db` on the compose network).
# From inside the app container, a database on the Windows/Mac host is host.docker.internal, not localhost.
# DATABASE_URL=Host=host.docker.internal;Port=5432;Database=bets;Username=app;Password=change-me

# ---------- Published port ----------
# deployd sets APP_PORT on the Pi. Locally the default is 127.0.0.1:8080.
# APP_PORT=8080
# APP_PUBLISH_HOST=127.0.0.1
# Previous Docker Desktop behavior (all host interfaces):
# APP_PUBLISH_HOST=0.0.0.0

# ---------- Resource limits (defaults match the Pi zip) ----------
# GEO_ALERTS_MEM_LIMIT=1g
# GEO_ALERTS_MEMSWAP_LIMIT=1g
# GEO_ALERTS_PIDS_LIMIT=256
# About 768MiB. Pi default is 0x9000000 (~144MiB) so the heap stays inside the 256m cap.
# DOTNET_GCHeapHardLimit=0x30000000

# Named volume by default. Uncomment to keep screenshot files in ./screenshots on the host.
# SCREENSHOT_VOLUME=./screenshots

# ---------- Feature flags ----------
ENABLE_TELEGRAM=false
# Use mock OREF data instead of live feed (true/false).
USE_OREF_MOCK=true

# ---------- Toolbar (runtime: no rebuild needed) ----------
# Set to true to show status toolbar (connection, alert count, last poll). Server exposes this at GET /api/config.
ACTIVE_TOOLBAR=true

# ---------- Client build (baked into the public JS bundle at image build time) ----------
# Passed as Docker build args. They are visible in image history and in the browser bundle.
# REACT_APP_GEOAPIFY_API_KEY=
# REACT_APP_OREF_TRAJECTORY_DEBUG=
# REACT_APP_CESIUM_ION_ACCESS_TOKEN=
# REACT_APP_STADIA_MAPS_API_KEY=

# ---------- Screenshot ----------
# SCREENSHOT_STORAGE_PATH=/app/screenshots
# SCREENSHOT_PUBLIC_URL=https://geo-alerts.toxic-ground-zero.com/api/screenshots
# SCREENSHOT_MIN_AREAS=40
# SCREENSHOT_MIN_MATCHED_SETTLEMENTS=10
# SCREENSHOT_ALERT_TITLE=ירי רקטות וטילים
# SCREENSHOT_COOLDOWN_MS=120000

# ---------- Telegram (when ENABLE_TELEGRAM=true) ----------
# Get token from @BotFather; create a channel and add the bot as admin.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Optional: for Telegram Client API (e.g. user auth). Get from https://my.telegram.org
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# ---------- Geo / geocode ----------
# GeoJSON is copied into the image at build time (client/public/data). This override is unused by the .NET data route.
# CLIENT_DATA_DIR=
# GEOCODE_BASE=
# NOMINATIM_URL=
