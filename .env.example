# Copy to .env in the repo root. Used ONLY by Docker Compose (docker compose up).
# Not used by the client or server when run locally. Do not commit .env (gitignored).

# ---------- Database ----------
# PostgreSQL connection string. Used as ConnectionStrings__DefaultDatabase in the container.
DATABASE_URL=Host=localhost;Port=5432;Database=bets;Username=app;Password=app

# ---------- Feature flags ----------
ENABLE_TELEGRAM=false
ENABLE_BETS=false
# Use mock OREF data instead of live feed (true/false).
USE_OREF_MOCK=true

# ---------- Toolbar (runtime: no rebuild needed) ----------
# Set to true to show main app toolbar (login, wallet, bets). Server exposes this at GET /api/config.
ACTIVE_TOOLBAR=true

# ---------- Client build (optional; only if you need these in the bundle at build time) ----------
# REACT_APP_GEOAPIFY_API_KEY=
# REACT_APP_OREF_TRAJECTORY_DEBUG=
# REACT_APP_CESIUM_ION_ACCESS_TOKEN=

# ---------- Betting (when ENABLE_BETS=true) ----------
# BET_EXPIRY_GRACE_MS=
# BET_PROXIMITY_EXPIRY_GRACE_MS=
# BET_EXPIRY_LOOP_INTERVAL_MS=
# BET_REGION_PAYOUT_MULTIPLIER=
# BET_PLATFORM_FEE_RATIO=
# BET_EXACT_POOL_SHARE=
# BET_NEAR_WINNER_MINUTES=

# ---------- Screenshot ----------
# SCREENSHOT_STORAGE_PATH=/app/screenshots
# SCREENSHOT_PUBLIC_URL=http://localhost:8080/api/screenshots
# SCREENSHOT_MIN_AREAS=40
# SCREENSHOT_MIN_MATCHED_SETTLEMENTS=10
# SCREENSHOT_ALERT_TITLE=ירי רקטות וטילים
# SCREENSHOT_COOLDOWN_MS=120000

# ---------- Telegram (when ENABLE_TELEGRAM=true) ----------
# Get token from @BotFather; create a channel and add the bot as admin.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Optional: for Telegram Client API (e.g. user auth). Get from https://my.telegram.org
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# ---------- Geo / geocode ----------
# CLIENT_DATA_DIR=/app/client-data
# GEOCODE_BASE=
# NOMINATIM_URL=
