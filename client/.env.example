# Geoapify API key for Boundaries API (alert polygons from cities.json).
# Get a key at https://www.geoapify.com/
# Copy this file to .env and set your key. Restart dev server after changing.
REACT_APP_GEOAPIFY_API_KEY=your_api_key_here

# Strike news: server uses RSS (BBC, Al Jazeera) + optional Telegram. Poll every 2–5 min.
# Optional: TELEGRAM_BOT_TOKEN (server env) for bot-based ingestion; or use Python Telethon script (no bot).
# Optional: RSS_FEED_URLS (server env) – comma-separated feed URLs to add/replace defaults.
