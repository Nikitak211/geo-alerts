# Copy to client/.env. Used by React (npm start / npm run build). Restart dev server after changes.
# Only REACT_APP_* are embedded in the bundle (public). Do not put secrets here.

# ---------- Dev server ----------
PORT=4421

# Allow build to complete even when TypeScript reports errors (avoids "Compiled with problems" overlay).
TSC_COMPILE_ON_ERROR=true

# ---------- API and WebSocket (for dev when client runs separately from backend) ----------
# HTTP API base. If unset, production uses same origin; dev defaults to http://localhost:8090.
# REACT_APP_API_BASE=http://localhost:8090

# WebSocket / SignalR hub URL. If unset, same-origin /ws is used (correct when SPA is served by .NET).
# For .NET backend on 8080: REACT_APP_WS_URL=http://localhost:8080/ws
# For Node backend: ws://localhost:5535
# REACT_APP_WS_URL=http://localhost:8080/ws

# ---------- Third-party API keys ----------
# Geoapify: for Boundaries API (alert polygons from cities). Get a key at https://www.geoapify.com/
REACT_APP_GEOAPIFY_API_KEY=your_api_key_here

# Cesium Ion: optional token for map imagery (higher quota). Get at https://cesium.com/ion/
# REACT_APP_CESIUM_ION_ACCESS_TOKEN=

# ---------- Optional UI / debug ----------
# Show main app toolbar (login, wallet, etc.). Set to a non-empty value to enable.
# REACT_APP_ACTIVE_TOOLBAR=true

# Show OREF trajectory debug layer on the map.
# REACT_APP_OREF_TRAJECTORY_DEBUG=false
