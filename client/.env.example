# Dev server port. Copy this file to .env and set values. Restart dev server after changing.
PORT=4421

# Geoapify API key for Boundaries API (alert polygons from cities.json).
# Get a key at https://www.geoapify.com/
REACT_APP_GEOAPIFY_API_KEY=your_api_key_here

# Allow build to complete even when TypeScript reports errors (avoids "Compiled with problems" overlay).
TSC_COMPILE_ON_ERROR=true
