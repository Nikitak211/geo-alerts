# Root-level ignore when using root as build context (e.g. docker build -f client/Dockerfile .).
# Normal builds use context ./client or ./server so their own .dockerignore apply.
.git
.gitignore
# Exclude ALL .env files. Client REACT_APP_* values come in via BuildKit secret (client_env).
/.env
/.env.*
server/.env
server/.env.*
*.log
.DS_Store
node_modules
**/node_modules
**/dist
**/build
**/coverage
*.md
docs
client/.env
client/.env.*
!client/.env.example
Server/.env
Server/.env.*
**/bin
**/obj
Server/wwwroot
screenshots
